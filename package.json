{
  "name": "ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Подготовка к ПР7: Playwright Test и Chromium",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test tests/counter.spec.js --debug",
    "report": "playwright show-report",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=.browsers playwright install chromium"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
